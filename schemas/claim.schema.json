{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAGE Intelligence Claim",
  "description": "Standard structure for technical research claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim",
    "status",
    "confidence",
    "scope",
    "source_ids",
    "limitations",
    "review_status"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-[0-9]{4,}$"
    },
    "claim": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "reported",
        "inference",
        "hypothesis",
        "unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "scope": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{4,}$"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "open",
        "needs_review",
        "needs_primary_review",
        "reviewed"
      ]
    }
  }
}
